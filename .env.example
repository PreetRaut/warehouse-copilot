# Copy to .env and fill in. .env is git-ignored.
# Get these from Snowsight after signing up for the free trial.

# Account identifier, e.g. ab12345.eu-west-1  (Snowsight > Admin > Accounts)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Key-pair auth (recommended; required if your account enforces MFA).
# Absolute path to your PKCS#8 private key. When set, this is used instead
# of the password. Leave blank to use password auth.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Only if your key file is encrypted with a passphrase:
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Ingestion + dbt use the read/write role; the MCP server should use the RO role.
SNOWFLAKE_ROLE=WAREHOUSE_COPILOT_RW
SNOWFLAKE_WAREHOUSE=WH_XS
SNOWFLAKE_DATABASE=WAREHOUSE_COPILOT
SNOWFLAKE_SCHEMA_RAW=RAW
SNOWFLAKE_SCHEMA_ANALYTICS=ANALYTICS

# MCP safety limits
MCP_ROW_LIMIT=100
MCP_STATEMENT_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
